rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation Blueprint for Loot
    function isValidLoot(data) {
      return data.keys().hasAll(['userId', 'type', 'target', 'data', 'timestamp']) &&
             data.keys().size() == 5 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.type is string && data.type.size() > 0 && data.type.size() <= 50 &&
             data.target is string && data.target.size() > 0 && data.target.size() <= 200 &&
             data.data is string && data.data.size() > 0 && data.data.size() <= 100000 &&
             (data.timestamp is string || data.timestamp is timestamp);
    }

    // 8. Secure List Queries (The "Query Enforcer")
    match /loot/{lootId} {
      // Allow individual get and list queries ONLY if filtered by userId
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                      isValidLoot(incoming()) && 
                      incoming().userId == request.auth.uid;
                      
      allow update: if isSignedIn() && 
                      resource.data.userId == request.auth.uid && 
                      isValidLoot(incoming()) && 
                      incoming().userId == resource.data.userId;
                      
      allow delete: if isSignedIn() && 
                      resource.data.userId == request.auth.uid;
    }
  }
}
